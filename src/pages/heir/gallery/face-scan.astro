---
import PortfolioLayout from '../../../layouts/PortfolioLayout.astro';
import DesignGallery from '../../../components/DesignGallery.astro';
import { faceScanGallery as gallery } from '../../../data/face-scan-gallery';
const toc = gallery.chapters.map((chapter) => ({ slug: chapter.id, text: chapter.title, depth: 2 }));
---
<PortfolioLayout title={gallery.title} description={gallery.intro} toc={toc} gallery researchContext={{ label: 'Face Scan Gallery', returnHref: '/heir/#health-scan' }} prev={{ link: '/heir/gallery/phase-one/', label: 'Phase One Gallery' }}>
  <DesignGallery gallery={gallery} />
</PortfolioLayout>
