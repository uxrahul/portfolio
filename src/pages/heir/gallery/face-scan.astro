---
import PortfolioLayout from '../../../layouts/PortfolioLayout.astro';
import GalleryImage from '../../../components/GalleryImage.astro';
import DesignRail from '../../../components/DesignRail.astro';
import { faceScanGallery as gallery } from '../../../data/face-scan-gallery';
import '../../../styles/face-scan-gallery.css';
const toc = gallery.chapters.map((chapter) => ({ slug: chapter.id, text: chapter.title, depth: 2 }));
---
<PortfolioLayout title={gallery.title} description={gallery.intro} toc={toc} gallery researchContext={{ label: 'Face Scan Gallery', returnHref: '/heir/#health-scan' }}>
  <div class="face-scan-gallery">
    <p class="gallery-intro">{gallery.intro}</p>
    {gallery.chapters.map((chapter, index) => (
      <section class="gallery-chapter" aria-labelledby={chapter.id}>
        <header class="gallery-chapter-header" data-gallery-reveal>
          <span class="gallery-chapter-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <h2 id={chapter.id}>{chapter.title}</h2>
        </header>
        {chapter.stories.map((story, storyIndex) => (
          <section class="gallery-story" id={story.id} aria-labelledby={`${story.id}-title`}>
            <header class="gallery-story-header" data-gallery-reveal>
              <h3 id={`${story.id}-title`}>{story.title}</h3>
              <p>{story.explanation}</p>
            </header>
            <div class:list={['gallery-composition', { 'has-references': story.references.length > 0, 'has-many-references': story.references.length > 1 }]}>
              {story.references.length > 0 && <div class="gallery-references" data-gallery-reveal>{story.references.map((image) => <GalleryImage image={image} />)}</div>}
              <DesignRail id={`${story.id}-designs`} label={story.title} images={story.screens} eager={index === 0 && storyIndex === 0} />
            </div>
          </section>
        ))}
      </section>
    ))}
  </div>
</PortfolioLayout>
<script>
  import { bindGalleryMotion } from '../../../lib/gallery-motion';
  bindGalleryMotion();
</script>
