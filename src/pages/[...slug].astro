---
import { getCollection, render } from 'astro:content';
import PortfolioLayout from '../layouts/PortfolioLayout.astro';
export async function getStaticPaths() {
  return (await getCollection('docs')).map((entry) => ({
    params: { slug: entry.id.replace(/(^|\/)index$/, '') || undefined }, props: { entry },
  }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const toc = headings.filter((heading) => heading.depth === 2 && (!entry.data.tocSections || entry.data.tocSections.includes(heading.slug)));
---
<PortfolioLayout {...entry.data} toc={toc}>
  <Content />
</PortfolioLayout>
