---
import ImageRail from './ImageRail.astro';
import ResearchFigure from './ResearchFigure.astro';
import type { FigureItem } from '../data/figures';
interface Props {
  id: string; label: string; items: FigureItem[];
  presentation?: 'stack' | 'carousel';
  variant?: 'statistical' | 'mobile-ui';
}
const { id, label, items, presentation = 'stack', variant = 'statistical' } = Astro.props;
if (!items.length) throw new Error('FigureGroup requires at least one figure.');
const carousel = presentation === 'carousel' && items.length > 1;
---
{carousel ? (
  <ImageRail id={id} label={label} count={items.length} noun="figure" class={`figure-rail figure-rail-${variant}`}>
    {items.map((item, index) => (
      <div class="figure-slide" id={item.id} style={`--rail-image-ratio: ${item.src.width / item.src.height}`} role="group" aria-label={`${index + 1} of ${items.length}`}>
        <ResearchFigure {...item} />
      </div>
    ))}
  </ImageRail>
) : (
  <div id={id} class="figure-group" role="region" aria-label={label}>
    {items.map((item) => <div class="figure-slide" id={item.id}><ResearchFigure {...item} /></div>)}
  </div>
)}
