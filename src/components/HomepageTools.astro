---
import { homepageTools as tools } from '../data/homepage-tools';
---
<ul class="homepage-tools" aria-label="Selected tools">
  {tools.map((tool, index) => <li><button type="button" class="homepage-tool-select" data-tool-select={index} aria-expanded="false" aria-controls="homepage-tool-popover" disabled>
    {tool.icon && <span class:list={['homepage-tool-mark', { monochrome: tool.monochrome }]} aria-hidden="true" set:html={tool.icon} />}
    <span>{tool.label}</span>
  </button></li>)}
</ul>
<div id="homepage-tool-popover" class="homepage-tool-popover" popover="auto" role="region" aria-live="polite" aria-atomic="true">
  {tools.map((tool, index) => <article data-tool-context={index} hidden>
    <header>
      <span class:list={['homepage-tool-mark', { monochrome: tool.monochrome }]} aria-hidden="true" set:html={tool.icon} />
      <h3 id={`tool-context-name-${index}`}>{tool.label}</h3>
    </header>
    <p id={`tool-context-description-${index}`}>{tool.description}</p>
  </article>)}
</div>
