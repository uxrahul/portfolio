---
import { withBase } from '../lib/paths';
import HomepageIntroduction from './HomepageIntroduction.astro';
import HomepageTools from './HomepageTools.astro';
import HomepageJourney from './HomepageJourney.astro';
import PhoneShowcase from './PhoneShowcase.astro';
import LiraPendant from './LiraPendant.astro';
import WorkDeck from './WorkDeck.astro';
import ToolSwarm from './ToolSwarm.astro';
import phoneFrame from '../assets/homepage/heir/iphone-frame.png';
import phoneScreen from '../assets/homepage/heir/home-long.png';
import '../styles/homepage.css';
import '../styles/homepage-responsive.css';
import '../styles/homepage-products.css';
---
<div class="homepage" data-homepage>
  <HomepageJourney>
  <HomepageIntroduction slot="introduction" />
  <section slot="heir" class="homepage-section homepage-impact journey-project" aria-labelledby="selected-impact">
    <h2 id="selected-impact" class="homepage-label">SELECTED IMPACT</h2>
    <div class="journey-heir-composition journey-project-composition">
      <div class="homepage-project-copy journey-project-copy">
        <p class="homepage-project-label">GANANCE / HEIR</p>
        <h3 id="career-heir"><a class="homepage-project-link" href={withBase('/heir/')}>Launching, scaling, and expanding HEIR<span class="homepage-project-arrow" aria-hidden="true">↗</span></a></h3>
        <p class="journey-project-description">Helped develop a screenless activity tracker as Ganance reached <strong>3,000+ device sales</strong> and <strong>2,000 preorders</strong>; expanded its app into personalized activity and health.</p>
      </div>
      <PhoneShowcase frame={phoneFrame} screen={phoneScreen} description="HEIR Home: daily steps and target, Pace, weather, and Day Rhythm activity breakdown." />
    </div>
  </section>
  <section slot="continuation" class="homepage-section journey-continuation journey-project journey-project--pendant" aria-labelledby="career-lira">
    <h2 class="homepage-label journey-lira-eyebrow">SELECTED IMPACT</h2>
    <div class="journey-project-composition">
    <div class="homepage-lira journey-project-copy">
      <p class="homepage-project-label">LIRA TECHNOLOGIES</p>
      <div>
        <h3 id="career-lira">Applying AI to everyday care</h3>
        <p class="journey-project-description">Designing an AI-assisted caregiving pendant and planning an eight-week pilot to evaluate its role in helping older adults age at home.</p>
        <p class="journey-project-status">Case study coming soon · Work in progress</p>
      </div>
    </div>
    <LiraPendant />
    </div>
  </section>
  <WorkDeck slot="how-i-work" />
  <section slot="select-tools" class="homepage-section homepage-tool-section" aria-labelledby="selected-tools" data-home-section>
    <h2 id="selected-tools" class="homepage-label" data-home-reveal>SELECT TOOLS</h2>
    <div class="tools-static" data-home-reveal><HomepageTools /></div>
    <ToolSwarm />
  </section>
  </HomepageJourney>
</div>
<script>
  import { bindHomepageMotion } from '../lib/homepage-motion';
  import { bindResponsiveHomepage } from '../lib/homepage-responsive';
  import { bindHomepageProducts } from '../lib/homepage-products';
  bindHomepageMotion();
  bindResponsiveHomepage();
  bindHomepageProducts();
</script>
