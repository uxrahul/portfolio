---
import { Image } from 'astro:assets';
import pendant from '../assets/homepage/lira/lira-pendant-studio.webp';
import darkPendant from '../assets/homepage/lira/lira-pendant-studio-dark.webp';
import '../styles/lira-pendant.css';
// Source-pixel geometry: the visible hardware is an open C channel, not a
// closed circle. The upper capsule is a separate light. Do not bridge the gap.
const channel = 'M459 638 A216 216 0 1 0 794 638';
const description = 'Lira caregiving pendant with an ivory body, circular central control, and open ring-light channel.';
---
<figure class="lira-pendant" data-lira-pendant>
  <div class="lira-pendant-artwork">
  <!-- Permanent material sits beneath both transparent originals. Only the
       light above it responds to scroll; unlit hardware never becomes a hole. -->
  <svg class="lira-pendant-diffuser" viewBox="0 0 1254 1254" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="lira-frosted-material" gradientUnits="userSpaceOnUse" x1="430" y1="480" x2="800" y2="1010">
        <stop offset="0" class="lira-frost-highlight" />
        <stop offset=".35" class="lira-frost-body" />
        <stop offset=".7" class="lira-frost-shadow" />
        <stop offset="1" class="lira-frost-highlight" />
      </linearGradient>
      <filter id="lira-frost-softness" x="-50%" y="-20%" width="200%" height="140%"><feGaussianBlur stdDeviation="2" /></filter>
    </defs>
    <path d={channel} class="lira-diffuser-channel" />
    <path d={channel} class="lira-diffuser-sheen" />
    <rect x="610" y="481" width="33" height="87" rx="16.5" class="lira-diffuser-indicator" />
    <rect x="620" y="490" width="13" height="67" rx="6.5" class="lira-diffuser-indicator-sheen" />
  </svg>
  <Image src={pendant} alt={description} widths={[480, 800, 1254]} sizes="(min-width: 1200px) 550px, 100vw" format="webp" quality={95} loading="eager" class="lira-pendant-image lira-pendant-image--light" />
  <Image src={darkPendant} alt={description} widths={[480, 800, 1254]} sizes="(min-width: 1200px) 550px, 100vw" format="webp" quality={95} loading="eager" class="lira-pendant-image lira-pendant-image--dark" />
  <svg class="lira-pendant-light" viewBox="0 0 1254 1254" aria-hidden="true" focusable="false">
    <defs>
      <filter id="lira-ring-diffusion" x="-25%" y="-25%" width="150%" height="150%" color-interpolation-filters="sRGB"><feGaussianBlur stdDeviation="8" /></filter>
      <filter id="lira-ring-ambient" x="-35%" y="-35%" width="170%" height="170%" color-interpolation-filters="sRGB"><feGaussianBlur stdDeviation="16" /></filter>
      <filter id="lira-light-softness" x="-25%" y="-25%" width="150%" height="150%" color-interpolation-filters="sRGB"><feGaussianBlur stdDeviation="1.8" /></filter>
      <filter id="lira-indicator-diffusion" x="-100%" y="-40%" width="300%" height="180%" color-interpolation-filters="sRGB"><feGaussianBlur stdDeviation="7" /></filter>
      <linearGradient id="lira-emitted-light" gradientUnits="userSpaceOnUse" x1="440" y1="620" x2="810" y2="1000">
        <stop offset="0" class="lira-light-highlight" />
        <stop offset=".4" class="lira-light-tint" />
        <stop offset=".75" class="lira-light-highlight" />
        <stop offset="1" class="lira-light-tint" />
      </linearGradient>
    </defs>
    <g class="lira-ring-light">
      <path d={channel} pathLength="1" class="lira-ring-ambient" />
      <path d={channel} pathLength="1" class="lira-ring-bloom" />
      <path d={channel} pathLength="1" class="lira-ring-emitter" />
      <path d={channel} pathLength="1" class="lira-ring-core" />
    </g>
    <g class="lira-indicator-light">
      <rect x="612" y="483" width="29" height="83" rx="14.5" class="lira-indicator-bloom" />
      <rect x="613" y="484" width="27" height="81" rx="13.5" class="lira-indicator-emitter" />
      <rect x="621" y="492" width="11" height="65" rx="5.5" class="lira-indicator-core" />
    </g>
  </svg>
  </div>
  <button type="button" class="lira-pendant-replay" data-lira-replay aria-label="Replay Lira pendant illumination" hidden></button>
</figure>
