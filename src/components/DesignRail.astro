---
import ImageRail from './ImageRail.astro';
import GalleryImage from './GalleryImage.astro';
import type { GalleryImage as ImageItem } from '../data/face-scan-gallery';
interface Props { id: string; label: string; images: ImageItem[]; eager?: boolean; heading?: string; }
const { id, label, images, eager = false, heading = 'HEIR designs' } = Astro.props;
---
<ImageRail id={id} label={label} regionLabel={`${label} — HEIR designs`} heading={heading} count={images.length} reveal>
  {images.map((image) => <GalleryImage image={image} eager={eager} />)}
</ImageRail>
