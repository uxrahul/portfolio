---
import { withBase } from '../lib/paths';
interface Props { label: string; returnHref: string; }
const { label, returnHref } = Astro.props;
---
<div class="research-context">
  <nav aria-label="Breadcrumb">
    <ol role="list">
      <li>Work at Ganance</li>
      <li><a href={withBase('/heir/')}>Case study</a></li>
      <li aria-current="page">{label}</li>
    </ol>
  </nav>
  <a class="research-return" href={withBase(returnHref)}><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M16 10H4m5-5-5 5 5 5" /></svg>Back to the case study</a>
</div>
<style>
  .research-context { margin-bottom: var(--space-8); font-size: var(--type-small); color: var(--color-on-surface-variant); }
  .research-context ol { display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-2); list-style: none; padding: 0; margin: 0 0 var(--space-3); }
  .research-context li { padding: 0; margin: 0; }
  .research-context li + li::before { content: '›'; margin-right: var(--space-2); }
  .research-context a { color: inherit; }
  .research-context a:hover { color: var(--color-primary); }
  .research-return { display: inline-flex; align-items: center; gap: var(--space-2); }
</style>
<script>
  import { bindSectionMotion } from '../lib/section-motion';
  bindSectionMotion();
</script>
